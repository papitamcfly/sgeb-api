TZ=America/Mexico_City
PORT=3333
HOST=localhost
LOG_LEVEL=info
NODE_ENV=development
APP_KEY=

# ── PostgreSQL (VPS 3, vía WireGuard) ──────────────────────────────
DB_HOST=10.8.0.3
DB_PORT=5432
DB_USER=sgeb
DB_PASSWORD=
DB_DATABASE=sgeb

# ── Módulo de identidad (SSO) ──────────────────────────────────────
SSO_JWKS_URL=https://auth.sgeb.mediocres.mx/.well-known/jwks.json
# local mientras el proveedor comparta proceso con la API; remoto tras extraerlo.
SSO_JWKS_MODE=local
SSO_ISSUER=https://auth.sgeb.mediocres.mx
SSO_AUDIENCE=sgeb-api
# Llave maestra AES-256-GCM que cifra las llaves privadas de firma en reposo.
# 32 bytes en hexadecimal. Generar con:  openssl rand -hex 32
# NUNCA se versiona y NUNCA vive en la base de datos.
SSO_MASTER_KEY=

# ── MQTT (VPS 4, vía WireGuard) ────────────────────────────────────
MQTT_URL=mqtt://10.8.0.4:1883
MQTT_USERNAME=sgeb-api
MQTT_PASSWORD=