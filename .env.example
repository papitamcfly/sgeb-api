TZ=America/Mexico_City
PORT=3333
HOST=localhost
LOG_LEVEL=info
NODE_ENV=development
APP_KEY=

# ── PostgreSQL (VPS 3, vía WireGuard) ──────────────────────────────
DB_HOST=10.8.0.3
DB_PORT=5432
DB_USER=sgeb
DB_PASSWORD=
DB_DATABASE=sgeb

# ── Módulo de identidad (SSO) ──────────────────────────────────────
SSO_JWKS_URL=https://auth.sgeb.mediocres.mx/.well-known/jwks.json
# local mientras el proveedor comparta proceso con la API; remoto tras extraerlo.
SSO_JWKS_MODE=local

# ── Canal de tiempo real (socket.io) ───────────────────────────────
# Orígenes autorizados, separados por coma. Nunca usar *.
SOCKET_CORS_ORIGIN=https://sgeb.mediocres.mx,http://localhost:5173

# Orígenes del API y del proveedor. Sin barra final: el navegador compara
# el origen exacto y "https://x.mx/" no coincide con "https://x.mx".
CORS_ORIGIN=https://sgeb.mediocres.mx,http://localhost:5173
SSO_ISSUER=https://auth.sgeb.mediocres.mx
SSO_AUDIENCE=sgeb-api
# Llave maestra AES-256-GCM que cifra las llaves privadas de firma en reposo.
# 32 bytes en hexadecimal. Generar con:  openssl rand -hex 32
# NUNCA se versiona y NUNCA vive en la base de datos.
SSO_MASTER_KEY=

# ── Correo saliente (Mailtrap por SMTP) ────────────────────────────
# CORREO_MODO=log       escribe en el log. Desarrollo y pruebas
# CORREO_MODO=mailtrap  envía de verdad
CORREO_MODO=log
# Sandbox:    sandbox.smtp.mailtrap.io  (captura sin entregar)
# Producción: live.smtp.mailtrap.io     (entrega de verdad)
MAIL_HOST=sandbox.smtp.mailtrap.io
# 2525 porque el 25 y el 587 suelen estar bloqueados por los proveedores de nube
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-responder@sgeb.mediocres.mx
MAIL_FROM_NAME=SGEB

# Base de los enlaces que viajan por correo (invitación, recuperación)
APP_URL_PROVEEDOR=https://auth.sgeb.mediocres.mx

# ── Notificaciones push (Firebase Cloud Messaging) ─────────────────
# PUSH_MODO=log | firebase
PUSH_MODO=log
# Los tres campos del archivo de cuenta de servicio de Firebase.
# La llave privada lleva los saltos de línea escapados como \n.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── reCAPTCHA v3 ───────────────────────────────────────────────────
# CAPTCHA_MODO=log        acepta cualquier token. Desarrollo y pruebas
# CAPTCHA_MODO=recaptcha  verifica contra Google
#
# v3 y no v2: v2 muestra el desafío de las imágenes, y aquí el usuario típico
# es un mesero capturando su contraseña en el estacionamiento del salón, con
# una mano y con prisa. Un desafío visual ahí no protege, expulsa.
CAPTCHA_MODO=log
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
# 0.5 por defecto. Subirlo empieza a tirar usuarios legítimos —extensiones de
# privacidad, redes compartidas, incógnito— y aquí un falso positivo es un
# mesero que no puede entrar a trabajar.
RECAPTCHA_UMBRAL=0.5

# ── Almacenamiento de archivos (Supabase Storage, compatible S3) ───
# ALMACEN_MODO=local | s3
ALMACEN_MODO=local
# El bucket debe ser PRIVADO: se sirve solo por URL firmada de 15 minutos.
S3_ENDPOINT=https://<proyecto>.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=sgeb-comandas
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── MQTT (VPS 4, vía WireGuard) ────────────────────────────────────
MQTT_URL=mqtt://10.8.0.4:1883
MQTT_USERNAME=sgeb-api
MQTT_PASSWORD=